+//! Libc bindings for teeos
+//!
+//! Apparently the loader just dynamically links it anyway, but fails
+//! when linking is explicitly requested.
+#![allow(non_camel_case_types)]
+#![allow(non_snake_case)]
+
+use crate::prelude::*;
+
+pub type c_bool = i32;
+
+pub type intmax_t = i64;
+
