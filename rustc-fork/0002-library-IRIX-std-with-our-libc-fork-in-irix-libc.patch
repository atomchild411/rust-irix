+    pub fn pthread_setschedprio(thread: pthread_t, prio: c_int) -> c_int;
+
+    // Thread attributes
+    pub fn pthread_attr_init(attr: *mut pthread_attr_t) -> c_int;
+    pub fn pthread_attr_destroy(attr: *mut pthread_attr_t) -> c_int;
