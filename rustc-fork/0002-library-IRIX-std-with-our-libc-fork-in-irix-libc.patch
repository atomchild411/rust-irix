+    cfg.skip_roundtrip(move |s| match s {
+        // FIXME(macos): this type has the wrong ABI
+        "max_align_t" if i686 => true,
+        _ => false,
+    });
+
+    ctest::generate_test(&mut cfg, "../src/lib.rs", "ctest_output.rs").unwrap();
