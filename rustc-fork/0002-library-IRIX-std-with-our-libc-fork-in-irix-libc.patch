+use crate::off_t;
+use crate::prelude::*;
+
+pub type __u64 = c_ulonglong;
+pub type wchar_t = u32;
+pub type nlink_t = c_ulong;
+pub type blksize_t = c_long;
+
+s! {
+    pub struct stat {
+        pub st_dev: crate::dev_t,
+        pub st_ino: crate::ino_t,
+        pub st_mode: crate::mode_t,
