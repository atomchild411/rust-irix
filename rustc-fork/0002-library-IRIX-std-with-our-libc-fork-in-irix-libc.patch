+cfg_if! {
+    if #[cfg(doc)] {
+        // Used in `linux::arch` to define ioctl constants.
+        pub(crate) type Ioctl = c_ulong;
+    } else {
+        #[doc(hidden)]
+        pub type Ioctl = c_ulong;
+    }
+}
