+    pub fn backtrace_symbols_fd(addrlist: *const *mut c_void, len: size_t, fd: c_int) -> c_int;
+    pub fn backtrace_symbols_fmt(
+        addrlist: *const *mut c_void,
+        len: size_t,
+        fmt: *const c_char,
+    ) -> *mut *mut c_char;
+}
