+        pub flags: c_ulonglong,
+        pub pidfd: c_ulonglong,
+        pub child_tid: c_ulonglong,
+        pub parent_tid: c_ulonglong,
+        pub exit_signal: c_ulonglong,
+        pub stack: c_ulonglong,
+        pub stack_size: c_ulonglong,
